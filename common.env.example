# 每台机器在不入库的 common.env 中配置对应平台的群晖同步根目录。
CLOUDSTATION_ROOT_WINDOWS=D:\CloudStaion
CLOUDSTATION_ROOT_MACOS=~/SynologyDrive/
CLOUDSTATION_ROOT_LINUX=~/CloudStation

# 可选：显式覆盖平台自动选择，或直接覆盖本工作流资料目录。
# CLOUDSTATION_ROOT=/path/to/cloud/root
# HOTEL_REQUIREMENTS_ROOT=/path/to/sample/input
LOG_LEVEL=INFO

# 可选：覆盖输出文件名。
ARCHIVE_JSON_NAME=酒店需求工作联系单数据.json
ARCHIVE_HTML_NAME=酒店需求工作联系单汇总.html
