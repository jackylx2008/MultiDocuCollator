# 每台机器在不入库的 common.env 中配置对应平台的群晖同步根目录。
CLOUDSTATION_ROOT_WINDOWS=D:\CloudStation
CLOUDSTATION_ROOT_MACOS=~/SynologyDrive/
CLOUDSTATION_ROOT_LINUX=~/CloudStation

# 可选：显式覆盖平台自动选择，或直接覆盖本工作流资料目录。
# CLOUDSTATION_ROOT=/path/to/cloud/root
# HOTEL_REQUIREMENTS_ROOT=/path/to/sample/input
LOG_LEVEL=INFO

# 可选：覆盖输出文件名。
ARCHIVE_JSON_NAME=酒店需求工作联系单数据.json
ARCHIVE_HTML_NAME=酒店需求工作联系单汇总.html
ARCHIVE_TEMPLATE_NAME=需求工作联系单模板.docx

# Windows 11 本地 AI（llama.cpp）配置，仅访问本机回环地址。
LLAMACPP_BASE_URL=http://127.0.0.1:8080/v1
LLAMACPP_MODEL=Qwen_Qwen2.5-VL-7B-Instruct-Q4_K_S.gguf
LLAMACPP_AUTOSTART=true
LLAMACPP_SERVER_PATH=D:\llama-cpp-cu12\llama-server.exe
LLAMACPP_MODEL_PATH=C:\path\to\model.gguf
LLAMACPP_MMPROJ_PATH=C:\path\to\mmproj.gguf
LLAMACPP_N_GPU_LAYERS=999
LLAMACPP_STARTUP_TIMEOUT_SEC=180
LLAMACPP_STARTUP_POLL_INTERVAL_SEC=1
LLAMACPP_TIMEOUT_SEC=180
LLAMACPP_STDOUT_LOG_PATH=log/llama_server.out.log
LLAMACPP_STDERR_LOG_PATH=log/llama_server.err.log
