# 复制为不入库的 .env；也兼容旧的 common.env。
CLOUDSTATION_ROOT_WINDOWS=D:\CloudStation
CLOUDSTATION_ROOT_MACOS=~/SynologyDrive/
CLOUDSTATION_ROOT_LINUX=~/CloudStation

# 可选：显式覆盖平台自动选择，或直接覆盖本工作流资料目录。
# CLOUDSTATION_ROOT=/path/to/cloud/root
# HOTEL_REQUIREMENTS_ROOT=/path/to/sample/input
LOG_LEVEL=INFO

# 可选：覆盖输出文件名。
ARCHIVE_JSON_NAME=酒店需求工作联系单数据.json
ARCHIVE_HTML_NAME=酒店需求工作联系单汇总.html
ARCHIVE_TEMPLATE_NAME=需求工作联系单模板.docx

# 外部启动器管理的本地 AI；本项目只检查并调用回环 API。
LLAMACPP_BASE_URL=http://127.0.0.1:8080/v1
LLAMACPP_MODEL=Qwen3.8-27B-Q4_K_M.gguf
# 独立启动器启用 API 鉴权时填写；未启用时留空。
LLAMACPP_API_KEY=
LLAMACPP_TIMEOUT_SEC=180
